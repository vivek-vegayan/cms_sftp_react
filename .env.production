# Production build configuration (used automatically by `vite build`).
# Overrides .env for production builds only.

# cms_sftp_spring base URL, served behind Nginx.
VITE_REACT_APP_BASE_URL=http://10.240.129.36:9000/cms_sftp

# Where this SPA is served from. Must match the Nginx location block.
VITE_APP_BASE_PATH=/cms_sftp/

# The main CHM UI (airtelcms_react), for the header's "Back to CHM" link.
VITE_MAIN_APP_URL=https://chngmgmt.airtel.com:9443/airtelcms/
